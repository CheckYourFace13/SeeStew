# YouTube
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=

# Google AdSense (live site: ca-pub-9572509189594279)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-9572509189594279
NEXT_PUBLIC_ADSENSE_ENABLED=true

# Google Search Console — HTML tag method (meta content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — if you use GA (copy G- ID from Analytics → Data streams)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# OpenRouter story pipeline
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
PIPELINE_MAX_STORIES=2
CRON_SECRET=

# Contact form (SMTP) — server only; never expose CONTACT_TO_EMAIL to the browser
CONTACT_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# OpusClip daily social poster (local shorts → SeeStew FB/IG/TikTok/YouTube)
# Get key: https://clip.opus.pro/dashboard → API Access
OPUSCLIP_API_KEY=
# Optional override (default is the AtlasShortsCopiedHere folder)
# OPUSCLIP_VIDEO_DIR=C:\Users\chris\OneDrive\Documents\Businesses\YouTube\SeeStew\AtlasShortsCopiedHere

# IndexNow (Bing Webmaster) — key file is public/<KEY>.txt (public by design)
INDEXNOW_KEY=39f4a09627794f9d938e051350d8169e

# Weekly email digest via SendFable embed (form id seestew-newsletter)
# See docs/sendfable-seestew-setup.md — set false to hide signup UI
NEXT_PUBLIC_EMAIL_SIGNUP_ENABLED=true
# NEXT_PUBLIC_SENDFABLE_FORM_ID=seestew-newsletter
# Optional API later (server-only):
# SENDFABLE_API_KEY=
# SENDFABLE_AUDIENCE_ID=

# CJ Affiliate Network (server-only — never NEXT_PUBLIC_)
# Promotional property / website ID is coded as CJ_WEBSITE_PID=101904039
# Paste PAT in Hostinger env only; do not commit. See docs/CJ_SEESTEW_SETUP.md
# CJ_PERSONAL_ACCESS_TOKEN=
